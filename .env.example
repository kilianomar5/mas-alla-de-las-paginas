# Copy this file to `.env` and fill in real values for local development.
# In production, set the same variables in Netlify → Site settings → Environment variables.
# `.env` is gitignored; only this example is committed.

# --- MailerLite (server-side, used by netlify/functions/newsletter-subscribe.js) ---
MAILERLITE_API_KEY=your-mailerlite-api-key
MAILERLITE_GROUP_ID=your-mailerlite-group-id

# --- Cloudflare Turnstile (bot protection) ---
# The public site key is hardcoded in src/components/home/NewsletterSection.vue.
# Only the secret key is a secret — used by the function to verify tokens.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Comma-separated allowlist of domains permitted to submit the form. Recommended in
# production (set it in Netlify's Production context so deploy previews still work).
# Leave unset to allow any hostname.
TURNSTILE_HOSTNAMES=lmdouglas.com,www.lmdouglas.com
